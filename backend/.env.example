APP_ENV=local
DATABASE_URL=sqlite:///./dev.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL=
SUPABASE_JWT_SECRET= # or SUPABASE_JWKS_URL, per project settings
CORS_ORIGINS=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_ENABLED=true
LLM_TIMEOUT_S=15
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_CHAT=20/minute
STRAVA_CLIENT_ID= # optional
STRAVA_CLIENT_SECRET= # optional
LOG_LEVEL=info
