// CarbonQuest Prisma Schema
// Compatible with SQLite (local development/testing) and Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String?
  name             String
  ageBand          String?           // e.g. "18-24", "25-34", "35-49", "50+"
  location         String            @default("Pune, India")
  householdSize    Int               @default(2)
  homeType         String            @default("Apartment") // "Apartment", "Independent House", "Hostel"
  role             String            @default("user") // "user", "admin"
  units            String            @default("metric")
  theme            String            @default("system")
  onboardingStatus String            @default("completed") // "pending", "in_progress", "completed"
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relationships
  consents         Consent[]
  preferences      PreferenceProfile?
  activities       ActivityInput[]
  trips            Trip[]
  snapshots        FootprintSnapshot[]
  recommendations  Recommendation[]
  userActions      UserAction[]
  scenarios        Scenario[]
  goals            Goal[]
  badges           UserBadge[]
  pointsLedger     PointsLedger[]
  streak           Streak?
  ecoScoreHistory  EcoScoreHistory[]
  leaderboardEntry LeaderboardEntry?
  redemptions      Redemption[]
  conversations    ChatConversation[]
  integrations     IntegrationAccount[]
  auditLogs        AuditLog[]

  @@index([email])
}

model Consent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "analytics", "ai_processing", "telemetry_tracking", "marketing"
  granted   Boolean  @default(true)
  version   String   @default("1.0")
  timestamp DateTime @default(now())

  @@index([userId, type])
}

model PreferenceProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  willingCategories   String   @default("[\"transport\",\"electricity\",\"food\",\"shopping\",\"waste\"]") // JSON array
  budgetSensitivity   String   @default("medium") // "low", "medium", "high"
  preferredDifficulty String   @default("medium") // "easy", "medium", "hard"
  learnedAffinities   String   // JSON string of LearnedAffinities
  updatedAt           DateTime @updatedAt
}

model EmissionFactor {
  id          String   @id
  category    String   // "transport", "electricity", "food", "shopping", "waste"
  subcategory String
  unit        String
  value       Float    // kg CO2e per unit
  source      String   // e.g. "CEA Baseline v19", "IPCC AR6", "ARAI"
  year        Int
  region      String   @default("India")
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, active])
}

model ActivityInput {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  subcategory String
  amount      Float
  unit        String
  frequency   String   @default("monthly")
  source      String   @default("manual") // "manual", "strava", "tracker", "csv"
  dataQuality String   @default("estimated") // "measured", "estimated", "defaulted"
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, category, occurredAt])
}

model Trip {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             String   // e.g. "walk", "bicycle", "bus_city", "metro_rail", "two_wheeler_petrol"
  distanceKm       Float
  durationSec      Int
  avgSpeedKmh      Float
  maxSpeedKmh      Float?
  steps            Int?
  validationStatus String   @default("valid") // "valid", "suspicious", "rejected"
  validationReason String?
  co2AvoidedKg     Float    @default(0.0)
  source           String   @default("manual") // "gps_live", "strava", "manual"
  startLocation    String?
  endLocation      String?
  startedAt        DateTime @default(now())
  endedAt          DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([userId, validationStatus, startedAt])
}

model FootprintSnapshot {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  totalKg     Float
  byCategory  String    // JSON string of CategorySummary map
  lineItems   String    // JSON string of LineItemCalculation array
  confidence  Int       // 0 - 100
  version     Int       @default(1)
  createdAt   DateTime  @default(now())

  hotspots    Hotspot[]

  @@index([userId, periodStart])
}

model Hotspot {
  id         String            @id @default(uuid())
  snapshotId String
  snapshot   FootprintSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  category   String
  lineItem   String
  rank       Int
  kg         Float
  percent    Float
  severity   String            // "high", "medium", "low"

  @@index([snapshotId, rank])
}

model ActionTemplate {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            String
  category         String           // "transport", "electricity", "food", "shopping", "waste"
  description      String
  impactFormulaKey String
  difficulty       String           // "easy", "medium", "hard"
  costImpact       String           // "saves_money", "neutral", "costs_money"
  defaultMagnitude Float            @default(1.0)
  unit             String           @default("habit")
  tags             String           // JSON string array
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())

  recommendations  Recommendation[]

  @@index([category, active])
}

model Recommendation {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionTemplateId   String
  template           ActionTemplate @relation(fields: [actionTemplateId], references: [id], onDelete: Cascade)
  estimatedKgPerMonth Float
  priorityScore      Int
  scoreBreakdown     String         // JSON string
  rationale          String
  status             String         @default("shown") // "shown", "accepted", "modified", "skipped", "completed"
  shownAt            DateTime       @default(now())

  userActions        UserAction[]

  @@index([userId, status, priorityScore])
}

model UserAction {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  actionSlug       String
  title            String
  category         String
  status           String          @default("accepted") // "accepted", "modified", "skipped", "completed", "rejected"
  modifiedParams   String?         // JSON string
  skipReason       String?         // "not_practical", "too_costly", "not_interested", "already_doing", "other"
  estimatedMonthlyKg Float         @default(0.0)
  acceptedAt       DateTime        @default(now())
  completedAt      DateTime?

  checkins         ActionCheckin[]

  @@index([userId, status])
}

model ActionCheckin {
  id                  String     @id @default(uuid())
  userActionId        String
  userAction          UserAction @relation(fields: [userActionId], references: [id], onDelete: Cascade)
  date                DateTime   @default(now())
  done                Boolean    @default(true)
  notes               String?
  estimatedKgAvoided  Float      @default(0.0)
  createdAt           DateTime   @default(now())

  @@index([userActionId, date])
}

model Scenario {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  changes    String   // JSON string of BehaviorChange[]
  resultJson String   // JSON string of ScenarioSimulationResult
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Goal {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetPercent  Float    // e.g. 20%
  baselineKg     Float
  currentKg      Float
  deadline       DateTime
  status         String   @default("active") // "active", "achieved", "expired"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
}

model Badge {
  id          String      @id
  slug        String      @unique
  name        String
  category    String
  description String
  icon        String
  criteria    String
  xpReward    Int         @default(100)
  createdAt   DateTime    @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model PointsLedger {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int      // positive for earn, negative for redeem
  actionType  String   // e.g. "trip_verified", "action_checkin", "badge_earned", "redemption"
  description String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(1)
  longestStreak  Int      @default(1)
  lastActiveDate DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EcoScoreHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      // 0 - 100
  formula   String
  date      DateTime @default(now())

  @@index([userId, date])
}

model LeaderboardEntry {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  city        String   @default("Pune")
  group       String   @default("VIT Pune") // Campus / community group
  ecoScore    Int      @default(50)
  co2AvoidedKg Float   @default(0.0)
  points      Int      @default(0)
  rank        Int      @default(1)
  optOut      Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([ecoScore, rank])
}

model RewardItem {
  id          String       @id
  title       String
  description String
  category    String       // "badge", "certificate", "eco_partner", "theme"
  pointsCost  Int
  imageUrl    String?
  isDemoItem  Boolean      @default(true)
  active      Boolean      @default(true)

  redemptions Redemption[]
}

model Redemption {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardItemId String
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)
  redeemedAt   DateTime   @default(now())

  @@index([userId])
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Climate Advisory Session")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String           // "user", "assistant", "system"
  content        String
  toolCalls      String?          // JSON string if structured actions invoked
  groundingRefs  String?          // JSON string of referenced footprint numbers
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model IntegrationAccount {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String    // "strava", "google_maps"
  accountRef     String?
  accessToken    String?   // In production encrypted at rest
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  lastSyncAt     DateTime?
  status         String    @default("connected") // "connected", "disconnected", "error"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String   // e.g. "auth_login", "footprint_recalculated", "data_exported", "action_completed"
  metadata  String?  // JSON string
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId, event, timestamp])
}
