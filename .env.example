# ==========================================
# CarbonQuest Environment Variables
# ==========================================

# Database Connection (Prisma)
# Local SQLite default for zero-friction local execution:
DATABASE_URL="file:./dev.db"
# For Supabase PostgreSQL, use:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"

# AI / LLM Integration (Groq Llama 3.3 70B)
# Optional: If omitted, the deterministic fallback assistant responds accurately
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode (Quick switcher for judges & evaluators)
NEXT_PUBLIC_DEMO_MODE="true"

# Optional External Integrations
# Strava API (OAuth2)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/integrations/strava/callback"

# Google Maps / Distance API (Optional, fallback to Haversine calculation)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
